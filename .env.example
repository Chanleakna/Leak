# ---------------------------------------------------------------------------
# Set these in Vercel → Project → Settings → Environment Variables (Production).
# Each one overrides the default in app/lib/config.ts. After setting them,
# Redeploy once. You never have to touch code again — edit the sheet and the
# dashboard reflects it within ~15s (minus Google's publish cache, a few min).
#
# Use the "Publish to web" link of the WHOLE spreadsheet (File → Share →
# Publish to web), then grab each tab's gid from its URL (...#gid=NUMBER).
# Both sheets can share the same URL with different gids.
# ---------------------------------------------------------------------------

# Submissions tab (one row per SKU; PA Name is "PA | Store")
NEXT_PUBLIC_SUBMISSIONS_URL="https://docs.google.com/spreadsheets/d/e/XXXXXXXX/pubhtml"
NEXT_PUBLIC_SUBMISSIONS_GID="0"

# Master PA list tab (the full active PA roster)
NEXT_PUBLIC_MASTER_URL="https://docs.google.com/spreadsheets/d/e/XXXXXXXX/pubhtml"
NEXT_PUBLIC_MASTER_GID="0"
